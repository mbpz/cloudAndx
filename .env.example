# Review Google's Android SDK license before changing this to yes.
ACCEPT_ANDROID_SDK_LICENSES=no

DASHBOARD_PORT=8080
CONTROLLER_PORT=18081
DEVICE_BRIDGE_PORT=8090
ANDROID_ADB_PORT=5555
ANDROID_GRPC_PORT=8554

EMULATOR_CORES=4
EMULATOR_MEMORY_MB=4096
EMULATOR_GPU=swiftshader
EMULATOR_WIPE_DATA=0

# Direct compose.kvm.yaml use intentionally requires the exact value. Prefer
# androidctl, which detects it inside a temporary Docker container and does not
# persist host environment.
# KVM_GID=108
