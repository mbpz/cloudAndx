# Host ports remain loopback-only in compose.yaml.
ANDROID_ADB_PORT=5555
ANDROID_NOVNC_PORT=6080
DEVICE_BRIDGE_PORT=8090

# ReDroid virtual display. The browser bridge scales this to its 540x960 X11
# window while scrcpy retains the 1080-pixel max video dimension.
ANDROID_WIDTH=1080
ANDROID_HEIGHT=1920
ANDROID_DPI=480
ANDROID_FPS=60
