# Review Google's Android SDK license before changing this to yes.
ACCEPT_ANDROID_SDK_LICENSES=no

# Immutable native AEMU identity. Change these only with sources.lock.json and
# its ordered patch set, then update the Compose contract test in the same change.
NATIVE_AEMU_REVISION=37.1.7
NATIVE_AEMU_SOURCE_LOCK_SHA256=4663a00b87c46e488124549ec7c55dcdc334d18f95b9a865122e9b437f5df134
NATIVE_AEMU_PATCH_SET_SHA256=4b63c09cf28c6897a10c60d59ebbe7c05a628f3f2e11e554fafa5d722de7d2b4

DEVICE_BRIDGE_PORT=8090
ANDROID_ADB_PORT=5555
ANDROID_GRPC_PORT=8554

EMULATOR_CORES=8
EMULATOR_MEMORY_MB=4096
EMULATOR_GPU=swiftshader
EMULATOR_WIPE_DATA=0

# Direct compose.kvm.yaml use intentionally requires the exact host KVM group.
# KVM_GID=108
