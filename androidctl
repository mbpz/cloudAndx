#!/bin/sh
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)
NATIVE_ENGINE_IMAGE=${NATIVE_ENGINE_IMAGE:-cloudandx/aemu-native-engine:37.1.7}
NATIVE_AEMU_LOCK=${ROOT}/docker/emulator/native-engine/sources.lock.json

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf '%s\n' 'ERROR: sha256sum or shasum is required to identify the native AEMU sources.' >&2
    exit 69
  fi
}

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    printf '%s\n' 'ERROR: sha256sum or shasum is required to identify the native AEMU patches.' >&2
    exit 69
  fi
}

locked_native_patch_paths() {
  sed -n '/^[[:space:]]*"patches": {/,/^[[:space:]]*}[,]*$/p' "${NATIVE_AEMU_LOCK}" \
    | sed -n 's/^[[:space:]]*"\(patches\/[^" ]*\.patch\)"[,]*$/\1/p'
}

compute_native_engine_identity() {
  [ -s "${NATIVE_AEMU_LOCK}" ] || {
    printf 'ERROR: native AEMU source lock is missing: %s\n' "${NATIVE_AEMU_LOCK}" >&2
    exit 66
  }
  NATIVE_AEMU_REVISION=$(sed -n \
    's/^[[:space:]]*"aemu_revision": "\([^"]*\)",*$/\1/p' \
    "${NATIVE_AEMU_LOCK}")
  [ -n "${NATIVE_AEMU_REVISION}" ] || {
    printf '%s\n' 'ERROR: native AEMU revision is missing from the source lock.' >&2
    exit 65
  }
  NATIVE_AEMU_SOURCE_LOCK_SHA256=$(sha256_file "${NATIVE_AEMU_LOCK}")
  native_patch_paths=$(locked_native_patch_paths)
  [ -n "${native_patch_paths}" ] || {
    printf '%s\n' 'ERROR: native AEMU patch order is missing from the source lock.' >&2
    exit 65
  }
  for native_patch_path in ${native_patch_paths}; do
    [ -f "${ROOT}/docker/emulator/native-engine/${native_patch_path}" ] || {
      printf 'ERROR: locked native AEMU patch is missing: %s\n' "${native_patch_path}" >&2
      exit 66
    }
  done
  NATIVE_AEMU_PATCH_SET_SHA256=$(
    for native_patch_path in ${native_patch_paths}; do
      native_patch_sha256=$(sha256_file \
        "${ROOT}/docker/emulator/native-engine/${native_patch_path}")
      printf '%s  %s\n' "${native_patch_sha256}" "${native_patch_path}"
    done | sha256_stream
  )
  export NATIVE_ENGINE_IMAGE NATIVE_AEMU_REVISION \
    NATIVE_AEMU_SOURCE_LOCK_SHA256 NATIVE_AEMU_PATCH_SET_SHA256
}

compute_native_engine_identity

runtime_implementation_for_engine() {
  if [ -n "${ANDROID_RUNTIME_IMPLEMENTATION-}" ]; then
    printf '%s\n' "${ANDROID_RUNTIME_IMPLEMENTATION}"
    return 0
  fi
  case $1 in
    arm64|aarch64) printf '%s\n' hybrid-aemu-arm64 ;;
    *) printf '%s\n' unsupported ;;
  esac
}

compose() {
  compose_engine_arch=$(docker_engine_architecture)
  compose_runtime_implementation=$(runtime_implementation_for_engine "${compose_engine_arch}")
  DOCKER_ENGINE_ARCHITECTURE=${compose_engine_arch} \
    ANDROID_RUNTIME_IMPLEMENTATION=${compose_runtime_implementation} \
    NATIVE_ENGINE_IMAGE=${NATIVE_ENGINE_IMAGE} \
    NATIVE_AEMU_REVISION=${NATIVE_AEMU_REVISION} \
    NATIVE_AEMU_SOURCE_LOCK_SHA256=${NATIVE_AEMU_SOURCE_LOCK_SHA256} \
    NATIVE_AEMU_PATCH_SET_SHA256=${NATIVE_AEMU_PATCH_SET_SHA256} \
    docker compose --project-directory "${ROOT}" -f "${ROOT}/compose.yaml" "$@"
}

compose_kvm() {
  compose_engine_arch=$(docker_engine_architecture)
  compose_runtime_implementation=$(runtime_implementation_for_engine "${compose_engine_arch}")
  DOCKER_ENGINE_ARCHITECTURE=${compose_engine_arch} \
    ANDROID_RUNTIME_IMPLEMENTATION=${compose_runtime_implementation} \
    NATIVE_ENGINE_IMAGE=${NATIVE_ENGINE_IMAGE} \
    NATIVE_AEMU_REVISION=${NATIVE_AEMU_REVISION} \
    NATIVE_AEMU_SOURCE_LOCK_SHA256=${NATIVE_AEMU_SOURCE_LOCK_SHA256} \
    NATIVE_AEMU_PATCH_SET_SHA256=${NATIVE_AEMU_PATCH_SET_SHA256} \
    docker compose --project-directory "${ROOT}" -f "${ROOT}/compose.yaml" -f "${ROOT}/compose.kvm.yaml" "$@"
}

configure_kvm_group() {
  KVM_GID=$(docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges --device /dev/kvm:/dev/kvm \
    alpine:3.22.1 stat -c %g /dev/kvm) || {
    printf '%s\n' 'ERROR: Docker cannot map /dev/kvm; KVM mode is unavailable and no host change was attempted.' >&2
    exit 1
  }
  export KVM_GID
}

require_docker() {
  command -v docker >/dev/null 2>&1 || {
    printf '%s\n' 'ERROR: Docker CLI is required.' >&2
    exit 1
  }
  docker info >/dev/null 2>&1 || {
    printf '%s\n' 'ERROR: Docker Engine is not reachable.' >&2
    exit 1
  }
}

docker_engine_os() {
  docker info --format '{{.OSType}}'
}

docker_engine_architecture() {
  docker info --format '{{.Architecture}}'
}

require_supported_linux_engine() {
  engine_os=$(docker_engine_os)
  engine_arch=$(docker_engine_architecture)

  case "${engine_os}/${engine_arch}" in
    linux/arm64|linux/aarch64)
      return 0
      ;;
    linux/amd64|linux/x86_64)
      printf 'ERROR: Docker Engine %s/%s is deferred until the x86_64 runtime is built and verified on x86_64 hardware.\n' "${engine_os}" "${engine_arch}" >&2
      printf '%s\n' 'No host, network, KVM, or OrbStack change was attempted.' >&2
      exit 78
      ;;
    *)
      printf 'ERROR: unsupported Docker Engine %s/%s.\n' "${engine_os}" "${engine_arch}" >&2
      printf '%s\n' 'The current supported build architecture is ARM64.' >&2
      printf '%s\n' 'No host, network, or OrbStack change was attempted.' >&2
      exit 78
      ;;
  esac
}

require_native_x86_linux_engine() {
  engine_os=$(docker_engine_os)
  engine_arch=$(docker_engine_architecture)
  printf 'ERROR: KVM and x86_64 runtime commands are deferred; got Docker Engine %s/%s.\n' "${engine_os}" "${engine_arch}" >&2
  printf '%s\n' 'No host, network, KVM, or OrbStack change was attempted.' >&2
  exit 78
}

build_native_engine() {
  docker build \
    --platform linux/arm64 \
    --target bundle \
    --build-arg "NATIVE_AEMU_REVISION=${NATIVE_AEMU_REVISION}" \
    --build-arg "NATIVE_AEMU_SOURCE_LOCK_SHA256=${NATIVE_AEMU_SOURCE_LOCK_SHA256}" \
    --build-arg "NATIVE_AEMU_PATCH_SET_SHA256=${NATIVE_AEMU_PATCH_SET_SHA256}" \
    --tag "${NATIVE_ENGINE_IMAGE}" \
    "${ROOT}/docker/emulator/native-engine"
}

ensure_native_engine() {
  native_identity=$(docker image inspect "${NATIVE_ENGINE_IMAGE}" --format \
    '{{.Os}}/{{.Architecture}}|{{index .Config.Labels "io.cloudandx.native-aemu.revision"}}|{{index .Config.Labels "io.cloudandx.native-aemu.source-lock-sha256"}}|{{index .Config.Labels "io.cloudandx.native-aemu.patch-set-sha256"}}' \
    2>/dev/null || true)
  required_identity="linux/arm64|${NATIVE_AEMU_REVISION}|${NATIVE_AEMU_SOURCE_LOCK_SHA256}|${NATIVE_AEMU_PATCH_SET_SHA256}"
  if [ "${native_identity}" = "${required_identity}" ]; then
    printf 'native-engine=%s identity=%s reuse=local\n' "${NATIVE_ENGINE_IMAGE}" "${native_identity}"
    return 0
  fi
  if [ -n "${native_identity}" ]; then
    printf 'native-engine=%s identity=%s reuse=rejected\n' "${NATIVE_ENGINE_IMAGE}" "${native_identity}" >&2
  fi
  build_native_engine
}

init() {
  compose build device-bridge
  compose run --rm --no-deps volume-init
  compose run --rm --no-deps adb-key-init
}

usage() {
  cat <<'EOF'
Usage: ./androidctl COMMAND [ARGS...]

  doctor             Validate Docker and the rendered Compose model
  init               Create Docker volumes, bridge token, and shared ADB key
  preflight          Verify the official Android 17 image metadata (no KVM required)
  preflight-kvm      Require an already-present /dev/kvm; never changes the host
  build-core         Build controller, bridge, dashboard, evidence gate, and tests
  build-native-engine Build the pinned native ARM64 AEMU bundle
  build-emulator     Reuse/build the pinned native AEMU bundle, then build Google Android
  up                 Start the current ARM64 software-emulation build path
  up-kvm             Fail closed (KVM/x86_64 runtime remains deferred)
  status             Show containers and the recorded evidence decision
  logs [SERVICE]     Follow stack logs
  adb [ARGS...]      Run bundled adb against the emulator
  shell [ARGS...]    Run an Android shell command through bundled adb
  token              Print the local bridge bearer token
  evidence           Print the preflight evidence JSON
  verify-runtime     Prove engine process, ADB, API 37, Play Store, and GMS
  down               Stop containers while preserving guest data
  destroy            Stop containers and delete this project's Docker volumes
  test               Run all offline tests inside Docker
EOF
}

require_docker

case ${1-} in
  doctor)
    docker version --format 'client={{.Client.Version}} server={{.Server.Version}}'
    docker info --format 'engine={{.OSType}}/{{.Architecture}} cpus={{.NCPU}} memory={{.MemTotal}}'
    compose config --quiet
    case "$(docker_engine_os)/$(docker_engine_architecture)" in
      linux/amd64|linux/x86_64) runtime_support=deferred-unverified-x86_64 ;;
      linux/arm64|linux/aarch64) runtime_support=supported-native-aemu-arm64 ;;
      *) runtime_support=blocked-unsupported-engine ;;
    esac
    printf 'compose=valid runtime=%s host-mutations=none\n' "${runtime_support}"
    ;;
  init)
    init
    ;;
  preflight)
    compose build evidence-gate
    compose run --rm evidence-gate
    ;;
  preflight-kvm)
    require_native_x86_linux_engine
    configure_kvm_group
    compose_kvm build evidence-gate
    compose_kvm run --rm evidence-gate
    ;;
  build-core)
    compose build controller device-bridge dashboard evidence-gate
    docker build --target test -t cloudandx/android-evidence-gate:test -f "${ROOT}/services/evidence-gate/Dockerfile" "${ROOT}"
    docker run --rm cloudandx/android-evidence-gate:test
    docker build --platform linux/amd64 --target test -t cloudandx/android-device-bridge:test "${ROOT}/services/device-bridge"
    docker run --rm --platform linux/amd64 cloudandx/android-device-bridge:test
    ;;
  build-native-engine)
    build_native_engine
    ;;
  build-emulator)
    ensure_native_engine
    compose build emulator
    ;;
  up)
    require_supported_linux_engine
    init
    ensure_native_engine
    compose up -d --build
    ;;
  up-kvm)
    require_native_x86_linux_engine
    init
    configure_kvm_group
    ensure_native_engine
    compose_kvm run --rm evidence-gate
    compose_kvm up -d --build
    ;;
  status)
    compose ps -a
    compose run --rm --no-deps --entrypoint /bin/sh volume-init -c 'if [ -s /volumes/evidence/preflight.json ]; then cat /volumes/evidence/preflight.json; else echo "evidence: unavailable"; fi'
    ;;
  logs)
    shift
    compose logs --follow --tail 200 "$@"
    ;;
  adb)
    shift
    compose exec -T emulator adb -s emulator-5556 "$@"
    ;;
  shell)
    shift
    compose exec -T emulator adb -s emulator-5556 shell "$@"
    ;;
  token)
    compose run --rm --no-deps volume-init >/dev/null
    compose run --rm --no-deps --entrypoint /bin/sh device-bridge -c 'cat /run/bridge-secrets/token'
    ;;
  evidence)
    compose run --rm --no-deps --entrypoint /bin/sh volume-init -c 'cat /volumes/evidence/preflight.json'
    ;;
  verify-runtime)
    compose exec -T emulator /usr/local/bin/runtime-preflight.sh
    compose exec -T emulator /usr/local/bin/healthcheck.sh
    printf '%s\n' 'runtime=verified engine-process=verified adb=device api=37 abi=arm64-v8a page-size=16384 play-store=present gms=present'
    ;;
  down)
    compose down --remove-orphans
    ;;
  destroy)
    compose down --volumes --remove-orphans
    ;;
  test)
    compose config --quiet
    docker run --rm --network none --read-only --cap-drop ALL \
      --security-opt no-new-privileges --tmpfs /tmp:rw,exec,nosuid,nodev,size=8m \
      -v "${ROOT}:/workspace:ro" -w /workspace alpine:3.22.1 \
      sh tests/androidctl-test.sh
    docker run --rm --network none --read-only --cap-drop ALL \
      --security-opt no-new-privileges \
      -v "${ROOT}:/workspace:ro" -w /workspace alpine:3.22.1 \
      sh tests/compose-contract-test.sh
    docker build --target self-test --pull=false -t cloudandx/android17-emulator:self-test "${ROOT}/docker/emulator"
    docker build --target test -t cloudandx/android-evidence-gate:test -f "${ROOT}/services/evidence-gate/Dockerfile" "${ROOT}"
    docker run --rm cloudandx/android-evidence-gate:test
    docker build --platform linux/amd64 --target test -t cloudandx/android-device-bridge:test "${ROOT}/services/device-bridge"
    docker run --rm --platform linux/amd64 cloudandx/android-device-bridge:test
    compose build controller dashboard
    docker run --rm --add-host controller:127.0.0.1 --add-host device-bridge:127.0.0.1 \
      --entrypoint /usr/sbin/nginx cloudandx/android-dashboard:1.0.0 -t
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    printf 'ERROR: unknown command: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
