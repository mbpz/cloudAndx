{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudandx:contract:android-capability-evidence:1.0.0",
  "title": "Android capability evidence contract",
  "description": "Fail-closed evidence bundle for every capability in a versioned Android full-phone capability catalog. Schema validity alone is not an acceptance decision; the acceptance contract defines cross-record and freshness gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "contract_id",
    "generated_at",
    "subject",
    "catalog",
    "capabilities",
    "completeness"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,127}$"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capabilityEvidence"
      }
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/capabilityEvidence"
                },
                {
                  "properties": {
                    "support_level": {
                      "not": {
                        "const": "not_supported"
                      }
                    },
                    "result": {
                      "properties": {
                        "status": {
                          "enum": [
                            "pass",
                            "not_applicable"
                          ]
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  "required": [
                    "support_level",
                    "result"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64}|sha512:[a-f0-9]{128})$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_observation_id",
        "android_version",
        "api_level",
        "image_manifest_uri",
        "image_manifest_digest",
        "route_set_id"
      ],
      "properties": {
        "release_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "android_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "api_level": {
          "type": "integer",
          "minimum": 1
        },
        "image_manifest_uri": {
          "type": "string",
          "format": "uri"
        },
        "image_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "route_set_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_uri",
        "catalog_digest",
        "effective_at",
        "capability_ids"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "catalog_uri": {
          "type": "string",
          "format": "uri"
        },
        "catalog_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_at": {
          "$ref": "#/$defs/timestamp"
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type",
        "scope_id",
        "android_version",
        "api_level"
      ],
      "properties": {
        "scope_type": {
          "enum": [
            "platform_release",
            "pool",
            "image",
            "device_sku",
            "sku_region_carrier",
            "pixel_entity"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "android_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "api_level": {
          "type": "integer",
          "minimum": 1
        },
        "image_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "device_sku": {
          "type": "string",
          "minLength": 1
        },
        "device_model": {
          "type": "string",
          "minLength": 1
        },
        "firmware_build": {
          "type": "string",
          "minLength": 1
        },
        "bootloader_lock_state": {
          "enum": [
            "locked",
            "unlocked"
          ]
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "test_sim_esim_profile_id": {
          "type": "string",
          "minLength": 1,
          "description": "Non-secret identifier for the approved test SIM/eSIM profile; use an explicit policy-defined N/A identifier when cellular service is outside the capability scope."
        },
        "account_profile_id": {
          "type": "string",
          "minLength": 1,
          "description": "Non-secret pseudonymous test-account profile identifier; credentials are forbidden."
        },
        "service_entitlement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_type": {
                "const": "device_sku"
              }
            },
            "required": [
              "scope_type"
            ]
          },
          "then": {
            "required": [
              "device_sku"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope_type": {
                "const": "sku_region_carrier"
              }
            },
            "required": [
              "scope_type"
            ]
          },
          "then": {
            "required": [
              "device_sku",
              "region",
              "carrier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope_type": {
                "const": "pixel_entity"
              }
            },
            "required": [
              "scope_type"
            ]
          },
          "then": {
            "required": [
              "device_model",
              "device_sku",
              "firmware_build",
              "bootloader_lock_state",
              "region",
              "carrier",
              "test_sim_esim_profile_id",
              "account_profile_id",
              "service_entitlement_ids"
            ]
          }
        }
      ]
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "pool_type",
        "environment_id"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "minLength": 1
        },
        "pool_type": {
          "enum": [
            "aosp_cuttlefish",
            "google_play_avd",
            "pixel_physical"
          ]
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_zone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerequisite_id",
        "kind",
        "assertion",
        "required",
        "validation_procedure_id"
      ],
      "properties": {
        "prerequisite_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "capability",
            "environment",
            "hardware",
            "network",
            "account",
            "license",
            "authorization",
            "safety_approval"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "validation_procedure_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "matcher",
        "value",
        "repetitions",
        "minimum_passes",
        "per_attempt_timeout_seconds"
      ],
      "properties": {
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "matcher": {
          "enum": [
            "equals",
            "not_equals",
            "matches_regex",
            "range_inclusive",
            "set_contains_all",
            "zero_unexpected_failures",
            "no_security_violation",
            "manual_attestation"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_passes": {
          "type": "integer",
          "minimum": 1
        },
        "per_attempt_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "uri",
        "digest",
        "media_type",
        "producer",
        "produced_at",
        "captured_at"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "produced_at": {
          "$ref": "#/$defs/timestamp"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "conditionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_of"
      ],
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_id",
              "assertion",
              "observed_value",
              "evidence_id"
            ],
            "properties": {
              "condition_id": {
                "$ref": "#/$defs/identifier"
              },
              "assertion": {
                "type": "string",
                "minLength": 1
              },
              "observed_value": {},
              "evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "notApplicableJustification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_kind",
        "statement",
        "catalog_applicability",
        "scoped_dimensions",
        "authority_evidence_id",
        "approved_by",
        "approved_at",
        "review_expires_at"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "rule_kind": {
          "enum": [
            "form_factor_exclusion",
            "sku_hardware_absence",
            "declared_region_carrier_exclusion",
            "legal_or_safety_prohibition"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 20,
          "description": "Must explain why the capability is semantically inapplicable. Test unavailability, implementation backlog, licensing delay, and unsupported hardware are not valid N/A reasons."
        },
        "catalog_applicability": {
          "const": false
        },
        "scoped_dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "review_expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluated_at",
        "attempts",
        "passed_attempts",
        "failed_attempts",
        "unexpected_failures",
        "leaked_resources",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run",
            "not_applicable"
          ]
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "execution_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "execution_completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "passed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "unexpected_failures": {
          "type": "integer",
          "minimum": 0
        },
        "leaked_resources": {
          "type": "integer",
          "minimum": 0
        },
        "observed_value": {},
        "observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "execution_started_at",
              "execution_completed_at"
            ],
            "properties": {
              "attempts": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "const": 0
              },
              "passed_attempts": {
                "const": 0
              },
              "failed_attempts": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "category",
        "target_scope",
        "form_factor",
        "pool",
        "support_level",
        "prerequisites",
        "test_procedure_id",
        "expected_result",
        "evidence",
        "expires_at",
        "result"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "framework_api",
            "system_ui",
            "gms_applications",
            "display_input",
            "graphics",
            "media",
            "camera_audio",
            "networking",
            "wifi",
            "bluetooth",
            "location",
            "sensors",
            "nfc",
            "telephony",
            "biometrics",
            "hardware_security",
            "integrity",
            "drm",
            "update",
            "compatibility",
            "lifecycle",
            "security",
            "reliability",
            "performance"
          ]
        },
        "target_scope": {
          "$ref": "#/$defs/targetScope"
        },
        "form_factor": {
          "enum": [
            "phone",
            "tablet",
            "tv",
            "automotive",
            "wear",
            "desktop",
            "headless",
            "virtual_phone"
          ]
        },
        "pool": {
          "$ref": "#/$defs/pool"
        },
        "support_level": {
          "enum": [
            "real",
            "high_fidelity",
            "simulated",
            "conditional",
            "not_supported",
            "not_applicable"
          ]
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          }
        },
        "conditions": {
          "$ref": "#/$defs/conditionSet"
        },
        "test_procedure_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
        },
        "expected_result": {
          "$ref": "#/$defs/expectedResult"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "not_applicable_justification": {
          "$ref": "#/$defs/notApplicableJustification"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "support_level": {
                "const": "conditional"
              }
            },
            "required": [
              "support_level"
            ]
          },
          "then": {
            "required": [
              "conditions"
            ]
          },
          "else": {
            "not": {
              "required": [
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "support_level": {
                "const": "not_applicable"
              }
            },
            "required": [
              "support_level"
            ]
          },
          "then": {
            "required": [
              "not_applicable_justification"
            ],
            "properties": {
              "result": {
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "not_applicable_justification"
              ]
            },
            "properties": {
              "result": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "not_applicable"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pool": {
                "properties": {
                  "pool_type": {
                    "const": "pixel_physical"
                  }
                },
                "required": [
                  "pool_type"
                ]
              }
            },
            "required": [
              "pool"
            ]
          },
          "then": {
            "properties": {
              "target_scope": {
                "allOf": [
                  {
                    "$ref": "#/$defs/targetScope"
                  },
                  {
                    "properties": {
                      "scope_type": {
                        "const": "pixel_entity"
                      }
                    },
                    "required": [
                      "scope_type"
                    ]
                  }
                ]
              },
              "form_factor": {
                "const": "phone"
              }
            }
          },
          "else": {
            "properties": {
              "target_scope": {
                "properties": {
                  "scope_type": {
                    "not": {
                      "const": "pixel_entity"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluated_at",
        "evaluator",
        "missing_capability_ids",
        "duplicate_capability_ids",
        "stale_capability_ids",
        "invalid_na_capability_ids",
        "failed_capability_ids",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "rejected"
          ]
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "missing_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "duplicate_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "stale_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "invalid_na_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "failed_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_capability_ids": {
                "maxItems": 0
              },
              "duplicate_capability_ids": {
                "maxItems": 0
              },
              "stale_capability_ids": {
                "maxItems": 0
              },
              "invalid_na_capability_ids": {
                "maxItems": 0
              },
              "failed_capability_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
