#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=${NATIVE_AEMU_ROOT:-${SCRIPT_DIR}}
NETSIMD=${ROOT}/libexec/linux-x86_64/netsimd

unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT LD_DEBUG LD_PROFILE LD_ASSUME_KERNEL GLIBC_TUNABLES
unset ANDROID_EGL_LIB ANDROID_GLESv1_LIB ANDROID_GLESv2_LIB ANDROID_EMULATOR_USE_SYSTEM_LIBS
unset ANDROID_EMU_VK_LOADER_PATH ANDROID_EMU_VK_ICD
unset VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH
unset VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE VK_LOADER_LAYERS_DISABLE VK_LOADER_DEBUG
unset LIBGL_DRIVERS_PATH LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER EGL_PLATFORM

exec "${NETSIMD}" "$@"
