From: CloudAndX <cloudandx@localhost>
Subject: [PATCH] opt in to x86_64 TCG engines for Linux AArch64

Keep the upstream target set unchanged unless the Docker-contained hybrid
engine build explicitly enables the option.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -117,5 +117,11 @@ set(OPTION_MINBUILD
       "Minimum set of components to support 64-bit guets only."
 )
+set(OPTION_X86_64_GUEST_ON_AARCH64
+    FALSE
+    CACHE
+      BOOL
+      "Build x86_64 TCG engines for a Linux AArch64 target."
+)
 set(OPTION_TCMALLOC
     TRUE
     CACHE
@@ -1010,7 +1016,7 @@ if(NOT OPTION_AEMU_LIBS_ONLY)
                                          android-qemu-deps android-emu)
 
   # Create the qemu targets.
-  if(NOT BUILDING_FOR_AARCH64)
+  if(NOT BUILDING_FOR_AARCH64 OR OPTION_X86_64_GUEST_ON_AARCH64)
     android_add_qemu_executable(
       x86_64 "${ANDROID_QEMU_i386_DEVICES_${ANDROID_TARGET_TAG}}")
     android_add_qemu_headless_executable(
