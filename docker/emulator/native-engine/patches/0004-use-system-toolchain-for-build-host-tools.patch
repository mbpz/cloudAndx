diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -121,6 +121,11 @@ set(OPTION_HEADLESS_ENGINE_ONLY
     CACHE BOOL
           "Build only the x86_64 headless engine, without the Qt launcher/UI targets."
 )
+set(OPTION_SYSTEM_HOST_TOOLCHAIN
+    FALSE
+    CACHE BOOL
+          "Use the container system compiler for build-host helper tools."
+)
 set(OPTION_X86_64_GUEST_ON_AARCH64
     FALSE
     CACHE
diff --git a/android/build/cmake/android.cmake b/android/build/cmake/android.cmake
--- a/android/build/cmake/android.cmake
+++ b/android/build/cmake/android.cmake
@@ -23,6 +23,16 @@
 # We want to make sure all the cross targets end up in a unique location
 set(ANDROID_CROSS_BUILD_DIRECTORY ${CMAKE_BINARY_DIR}/build/${ANDROID_HOST_TAG})
 
+if(OPTION_SYSTEM_HOST_TOOLCHAIN)
+  set(ANDROID_HOST_TOOLCHAIN_CMAKE_ARGS
+      "-DCMAKE_C_COMPILER=/usr/bin/gcc"
+      "-DCMAKE_CXX_COMPILER=/usr/bin/g++"
+      "-DCMAKE_MAKE_PROGRAM=/usr/bin/ninja")
+else()
+  set(ANDROID_HOST_TOOLCHAIN_CMAKE_ARGS
+      "-DCMAKE_TOOLCHAIN_FILE=${ANDROID_QEMU2_TOP_DIR}/android/build/cmake/toolchain-${ANDROID_HOST_TAG}.cmake")
+endif()
+
 set(ANDROID_XCODE_SIGN_ADHOC FALSE)
 
 if(APPLE)
@@ -79,7 +89,7 @@
         DOWNLOAD_COMMAND ""
         SOURCE_DIR ${SOURCE}
         CMAKE_ARGS
-          "-DCMAKE_TOOLCHAIN_FILE=${ANDROID_QEMU2_TOP_DIR}/android/build/cmake/toolchain-${ANDROID_HOST_TAG}.cmake"
+          ${ANDROID_HOST_TOOLCHAIN_CMAKE_ARGS}
           "-DBREAKPAD_API_KEY=${BREAKPAD_API_KEY}"
           "-DBREAKPAD_API_URL=${BREAKPAD_API_URL}"
           "-DOPTION_TEST_LOGS=${OPTION_TEST_LOGS}"
diff --git a/android/third_party/protobuf/CMakeLists.txt b/android/third_party/protobuf/CMakeLists.txt
--- a/android/third_party/protobuf/CMakeLists.txt
