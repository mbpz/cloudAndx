From: CloudAndX <cloudandx@localhost>
Subject: [PATCH] keep the hang detector paused for software TCG

CrashSystemInit initially pauses the HangDetector, but both emulator entry
paths unconditionally resume it before entering the UI loop. Software TCG can
legitimately keep the QEMU main and vCPU loopers busy beyond the detector
deadline during guest boot, after which the crash callback terminates an
otherwise progressing emulator.

Keep the detector paused when AEMU selected CPU_ACCELERATOR_NONE. Preserve the
existing pause pair for every accelerated mode and leave all watcher
registration, CPU-usage monitoring, and explicit guest-hang predicates intact.

diff --git a/android-qemu2-glue/main.cpp b/android-qemu2-glue/main.cpp
--- a/android-qemu2-glue/main.cpp
+++ b/android-qemu2-glue/main.cpp
@@ -1362,9 +1362,16 @@
     }
-
+
     skin_winsys_spawn_thread(opts->no_window, enter_qemu_main_loop, argc, argv);
-    android::crashreport::CrashReporter::get()->hangDetector().pause(false);
+    const bool watchForLooperHangs =
+            androidCpuAcceleration_getAccelerator() !=
+            ANDROID_CPU_ACCELERATOR_NONE;
+    if (watchForLooperHangs) {
+        android::crashreport::CrashReporter::get()->hangDetector().pause(false);
+    }
     skin_winsys_enter_main_loop(opts->no_window);
-    android::crashreport::CrashReporter::get()->hangDetector().pause(true);
+    if (watchForLooperHangs) {
+        android::crashreport::CrashReporter::get()->hangDetector().pause(true);
+    }
-
+
     // Make sure VirtualSceneManager and scene service library resources are
     // cleaned up properly
@@ -3620,9 +3627,16 @@
     skin_winsys_spawn_thread(opts->no_window, enter_qemu_main_loop, args.size(),
                              args.array());
-
+
-    android::crashreport::CrashReporter::get()->hangDetector().pause(false);
+    const bool watchForLooperHangs =
+            androidCpuAcceleration_getAccelerator() !=
+            ANDROID_CPU_ACCELERATOR_NONE;
+    if (watchForLooperHangs) {
+        android::crashreport::CrashReporter::get()->hangDetector().pause(false);
+    }
     skin_winsys_enter_main_loop(opts->no_window);
-    android::crashreport::CrashReporter::get()->hangDetector().pause(true);
+    if (watchForLooperHangs) {
+        android::crashreport::CrashReporter::get()->hangDetector().pause(true);
+    }
-
+
     // Make sure VirtualSceneManager and scene service library resources are
     // cleaned up properly
