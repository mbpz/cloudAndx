From: CloudAndX <cloudandx@localhost>
Subject: [PATCH] isolate Android 16 KiB granule advertisement

The pinned AEMU Cortex-A57 model advertises ID_AA64MMFR0_EL1 as 0x00001124,
while the Android 17 ps16k guest requires TGran16 bit 20 to be set. The
translation walker in target/arm/helper.c already handles 16 KiB tables with
stride 11, so no MMU implementation change is needed.

Add an explicit Android-only CPU model that inherits the Cortex-A57 defaults
and sets only TGran16 bit 20, producing 0x00101124. Keep cortex-a57,
cortex-a53, max, and host/KVM behavior unchanged unless the new model is
selected.

diff --git a/target/arm/cpu64.c b/target/arm/cpu64.c
--- a/target/arm/cpu64.c
+++ b/target/arm/cpu64.c
@@ -259,16 +259,26 @@ static void aarch64_max_initfn(Object *obj)
 #endif
     }
 }
 
+static void aarch64_android_a57_16k_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+
+    aarch64_a57_initfn(obj);
+    /* target/arm/helper.c implements 16 KiB table walks with stride 11. */
+    cpu->id_aa64mmfr0 |= 1ULL << 20;
+}
+
 typedef struct ARMCPUInfo {
     const char *name;
     void (*initfn)(Object *obj);
     void (*class_init)(ObjectClass *oc, void *data);
 } ARMCPUInfo;
 
 static const ARMCPUInfo aarch64_cpus[] = {
     { .name = "cortex-a57",         .initfn = aarch64_a57_initfn },
+    { .name = "android-a57-16k", .initfn = aarch64_android_a57_16k_initfn },
     { .name = "cortex-a53",         .initfn = aarch64_a53_initfn },
     { .name = "max",                .initfn = aarch64_max_initfn },
     { .name = NULL }
 };
